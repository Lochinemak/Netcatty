{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Netcatty",
  "version": "0.1.0",
  "identifier": "com.netcatty.desktop",
  "build": {
    "frontendDist": "../../../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev:renderer",
      "cwd": "../../..",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build:renderer",
      "cwd": "../../.."
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Netcatty",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "SSH manager, terminal and SFTP browser",
    "longDescription": "Netcatty is a modern SSH manager and terminal app with host grouping, SFTP, keychain, port forwarding, and a rich UI."
  }
}
